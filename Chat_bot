function detectLanguage(text) {
  const t = text.trim();
  if (!t) return 'en';
  const devanagari = (t.match(/[\u0900-\u097F]/g) || []).length;
  const gujarati = (t.match(/[\u0A80-\u0AFF]/g) || []).length;
  const totalChars = t.replace(/\s/g, '').length || 1;
  if (gujarati / totalChars > 0.3) return 'gu';
  if (devanagari / totalChars > 0.3) {
    const marathiMarkers = /\b(आहे|काय|कसा|कसे|कशी|तुम्ही|आम्ही|करू|दाखवा|पाहिजे|बद्दल|पण|खूप)\b/;
    if (marathiMarkers.test(t)) return 'mr';
    return 'hi';
  }
  const haryanviStrong = /\b(mhanne|mhaari|mhaare|kit hai|ke khaatir|raam raam)\b/i;
  const hinglishMarkers = /\b(hai|hain|kya|kaise|kahan|kab|main|aap|tum|hum|nahi|chahiye|karein|kar|raha|haan|theek|accha|bahut|kuch|aur|kyun|matlab|namaste|shukriya|kripya|abhi|order|product|dikhao|bechte|kursi|kitne|daam|saman|yaar|bhai|chalo|batao|sahi|galat|bilkul|zaroor|samjha|samjhi|pucho|puchho|bata|nahin|bohut|hota)\b/i;
  if (haryanviStrong.test(t)) return 'hr';
  if (hinglishMarkers.test(t)) return 'hinglish';
  return 'en';
}


