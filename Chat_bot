function detectMood(text) {
  const t = text.toLowerCase();
  // Frustrated/angry
  if (/(angry|gussa|frustrated|annoying|terrible|worst|horrible|pathetic|useless|bekaar|bekar|ghatiya|chutiya|stupid|idiot|hate|nafrat|disappointing|disappointed|bad service|kharab|gandi|gandagi|fed up|tang|presaan|pareshan|complain)/i.test(t)) {
    return 'frustrated';
  }
  // Happy/positive
  if (/(thanks|thank you|awesome|amazing|great|love|like|good|nice|wonderful|perfect|excellent|badhiya|mast|accha|achha|theek|sahi|jhakas|bahut accha|wah|wahh|wonderful|🔥|❤️|😍|🥰|😊)/i.test(t)) {
    return 'happy';
  }
  // Fun/casual
  if (/(joke|hasao|haso|bore|chill|fun|masti|gappein|chitchat|kuch toh bolo|baat|chal|let'?s talk|gpt|ai)/i.test(t)) {
    return 'fun';
  }
  // Confused
  if (/(confused|samajh nahi|samjha nahi|nahi samjha|not understand|don't get|kya bola|what)/i.test(t)) {
    return 'confused';
  }
  return 'neutral';
}


// ================================================================
// COMPREHENSIVE INTENT DETECTION
// ================================================================
function detectIntent(message, context) {
  const m = message.toLowerCase().trim();

  // ============ Damage / complaints (high priority) ============
  if (/(damaged|broken|toot|toota|tooti|crack|cracked|defective|kharab mil|defect|not working|nahi chal|chalti nahi|chalu nahi|missing parts|hardware missing|piece missing)/i.test(m)) {
    return { type: 'damaged' };
  }
  if (/(complaint|complain|shikayat|issue|problem|samasya|dikkat|presaan|trouble|baat karni|complaint karni|register complaint)/i.test(m)) {
    return { type: 'complaint' };
  }
  if (/(cancel|rad|reject|cancel my order|order cancel)/i.test(m)) {
    return { type: 'cancel_order' };
  }

  // ============ Greetings ============
  if (/^(hi+|hey+|hello+|hii|hola|namaste|namaskar|namastey|ram ram|salaam|kem cho|hare krishna|hye|helo|yo|sup)/i.test(m)) {
    return { type: 'greeting' };
  }
  if (/(how are you|kaise ho|kaisa hai|kya haal|kya hua|kasa aahes|kem cho|kemcho|all good)/i.test(m)) {
    return { type: 'how_are_you' };
  }

  // ============ Fun/casual ============
  if (/(joke|haso|hasao|funny|chutkula|jokes|laugh|hasi|laughter|bore|bored|boring|chill|fun|masti|gappein|gpt|ai|robot|bot|tum kya ho|tum kaun|are you human|are you ai|kya tum|tu kya hai)/i.test(m)) {
    if (/joke|chutkula|funny|haso|hasao|laugh/.test(m)) return { type: 'joke' };
    return { type: 'fun_mode' };
  }

  // ============ Compliments / insults ============
  if (/(love you|you are amazing|tum bahut acche|tu acha|aap great|good bot|nice bot|smart bot|cool|awesome|best chatbot|kamaal|jhakas|wah wah|maan gaye|smart|clever|intelligent|tum kitne smart|cute|sweet)/i.test(m)) {
    return { type: 'compliment' };
  }
  if (/(stupid bot|useless bot|bekaar bot|bekar bot|chutiya|bewakoof|gadha|idiot|moron|pathetic|sucks|sukar|ulloo|gadhe|stupid|dumb)/i.test(m)) {
    return { type: 'insult' };
  }

  // ============ About company / bot ============
  if (/(about (you|us|oakcraft|company)|tell me about|company (kya|details)|aap kaun|who are you|tumhi kon|kon ho|what is oakcraft|oakcraft kya|your name|naam kya|tera naam|tumhara naam)/i.test(m)) {
    return { type: 'about' };
  }

  // ============ Random / weather / off-topic ============
  if (/(weather|mausam|barish|dhoop|garmi|sardi|cricket|movie|film|news|samachar|prime minister|president|joke about|tell me joke about (?!furniture|chair))/i.test(m) && !/furniture|chair|product/.test(m)) {
    return { type: 'weather_or_random' };
  }

  // ============ Product categories ============
  if (/(gaming|gamer|racing chair|गेमिंग|ગેમિંગ)/i.test(m)) return { type: 'show_products', category: 'gaming' };
  if (/(recliner|रिक्लाइनर|રિક્લાઇનર)/i.test(m)) return { type: 'show_products', category: 'recliner' };
  if (/(bar stool|stool|स्टूल|સ્ટૂલ)/i.test(m)) return { type: 'show_products', category: 'stool' };
  if (/(accent chair|dining chair|lounge|living room chair|एक्सेंट|लाउंज|डाइनिंग|ડાઇનિંગ|લાઉન્જ)/i.test(m)) return { type: 'show_products', category: 'accent' };
  if (/(bookshelf|book shelf|shelf|shelves|storage|rack|bookcase|almari|बुकशेल्फ|अलमारी|स्टोरेज|રેક|બુકશેલ્ફ)/i.test(m)) return { type: 'show_products', category: 'shelf' };
  if (/(office chair|executive chair|task chair|computer chair|mesh chair|ऑफिस चेयर|ऑफिस कुर्सी|ઓફિસ ખુરશી|office ki kursi|study chair)/i.test(m)) return { type: 'show_products', category: 'office' };
  if (/(\bchair\b|kursi|कुर्सी|खुर्ची|ખુરશી)/i.test(m)) return { type: 'show_products', category: 'office' };

  // ============ Show all / browse ============
  if (/(all products|saare products|sab dikha|पूरा|सभी|बધા|all furniture|catalog|product list|kya bechte|kya available|browse|sab kuch|everything|पूरा सामान|whole collection|full range)/i.test(m)) {
    return { type: 'show_products', category: null };
  }

  // ============ Best sellers / recommendations ============
  if (/(best seller|popular|top rated|trending|top product|sabse jyada|best selling|recommended)/i.test(m)) {
    return { type: 'best_seller' };
  }
  if (/(recommend|suggest|kya lu|konsa lu|which one|which is best|kaunsa achha|sahi konsa|what should i|main kya|help me choose|help choose)/i.test(m)) {
    return { type: 'recommendation' };
  }

  // ============ Cheap / Premium ============
  if (/(cheap|sasta|sastaa|budget|kam paisa|low price|sasti|affordable|under \d+|kam mein|kam daam)/i.test(m)) {
    return { type: 'cheap_options' };
  }
  if (/(premium|expensive|mahnga|mahanga|luxury|high end|top tier|best quality)/i.test(m)) {
    return { type: 'premium_options' };
  }

  // ============ Service intents ============
  if (/(shipping|delivery|deliver|ship|kab (pahuch|aa|mil)|डिलीवरी|शिपिंग|ડિલિવરી|kab milega|kab pahunchega|delivery charges|kitne din|how long|how many days)/i.test(m)) {
    return { type: 'shipping' };
  }
  if (/(return|refund|exchange|replace|वापसी|रिटर्न|રિટર્ન|wapsi|paisa wapas|paise wapas)/i.test(m)) {
    return { type: 'returns' };
  }
  if (/(warranty|guarantee|वारंटी|गारंटी|વોરંટી)/i.test(m)) {
    return { type: 'warranty' };
  }
  if (/(price|cost|how much|kitne ka|kitna|rate|कीमत|दाम|किंमत|કિંમત|kitne ka|kitne mein|daam|mrp)/i.test(m)) {
    return { type: 'price_general' };
  }
  if (/(payment|pay|how to pay|kaise pay|paise|payment options|kaise pay karu)/i.test(m)) {
    return { type: 'payment' };
  }
  if (/(emi|installment|kisht)/i.test(m)) {
    return { type: 'emi' };
  }
  if (/(cod|cash on delivery|delivery pe pay)/i.test(m)) {
    return { type: 'cod' };
  }
  // Installation request — professional/technician installation (separate from DIY assembly)
  if (/(installation request|need installation|book installation|technician|professional install|installation chahiye|installation karwana|install karwa|install service|fitting service|assembly service|lagwana hai|lagwa do|fit karwa do|installation wala|technician chahiye|admi bhejo|aadmi bhejo|install karne wala)/i.test(m)) {
    return { type: 'installation' };
  }
  if (/(assembly|assemble|jodna|jodne|joint|install|setup|fitting|fit kaise|how to assemble|lagaana|lagaana kaise)/i.test(m)) {
    return { type: 'assembly' };
  }
  if (/(material|made of|kis cheez|fabric|wood|metal|leather|mesh|kis material|build quality|sturdy)/i.test(m)) {
    return { type: 'material' };
  }
  if (/(size|dimension|height|width|length|kitna bada|kitne size|how big|how tall|inches|cm|measurement|naap)/i.test(m)) {
    return { type: 'size_dimension' };
  }
  if (/(weight capacity|weight limit|how much weight|kitna weight|load|kg|kitne kilo)/i.test(m)) {
    return { type: 'weight_capacity' };
  }
  if (/(bulk|wholesale|corporate|थोक|बल्क|બલ્ક|office order|hotel|restaurant|many pieces|10 chairs|20 chairs|jada quantity)/i.test(m)) {
    return { type: 'bulk_order' };
  }
  if (/(contact|phone|email|call|कॉन्टैक्ट|baat karni|talk to|reach you|reach us|connect)/i.test(m)) {
    return { type: 'contact' };
  }
  if (/(track|order status|where is my order|mera order|ऑर्डर कहाँ|order kahan|order ka kya|status of order)/i.test(m)) {
    return { type: 'order_track' };
  }
  if (/(discount|offer|coupon|sale|deal|छूट|डिस्काउंट|ઑફર|chhoot|promo)/i.test(m)) {
    return { type: 'discount' };
  }
  if (/(open|hours|timings|kab khulta|when open|kab tak|24\/7)/i.test(m)) {
    return { type: 'hours_open' };
  }
  if (/(where (are|is)|location|address|kahan ho|kahan se|based|hq|office kahan)/i.test(m)) {
    return { type: 'location' };
  }
  if (/(instagram|facebook|social|follow|youtube|twitter|insta)/i.test(m)) {
    return { type: 'social_media' };
  }

  // ============ Closing / acknowledgment ============
  if (/(thank|शुक्रिया|धन्यवाद|shukriya|આભાર|thnks|tnx|ty|thx|thanku)/i.test(m)) {
    return { type: 'thanks' };
  }
  if (/^(bye|goodbye|tata|alvida|अलविदा|આવજો|cya|see you|chalta hu|chal main chalta)\b/i.test(m)) {
    return { type: 'bye' };
  }
  if (/^(yes|yeah|haan|haa|ji|ji haan|sure|ok|okay|theek|hoy|હા|chalo|tik hai|theek hai|fine|sahi|bilkul|zaroor)\b/i.test(m)) {
    return { type: 'yes_response' };
  }
  if (/^(no|nope|nahi|nahin|nay|nai|nahi chahiye|naah)\b/i.test(m)) {
    return { type: 'no_response' };
  }

  // ============ Search fallback (try product search if reasonable) ============
  if (m.length > 0 && m.length < 50 && /\b(want|chahiye|chaiye|need|chahta|chahti|दिखाओ|hawa|joiye|looking|find|search)\b/i.test(m)) {
    const searchMatch = m.match(/(?:want|chahiye|chaiye|need|chahta|chahti|hawa|joiye|looking for|find|search)\s+(.+)/i);
    if (searchMatch) return { type: 'search', query: searchMatch[1] };
  }

  // Try product search for short queries (might be a product keyword)
  if (m.length > 2 && m.length < 30 && !m.match(/[?!]/)) {
    const results = searchProducts(m);
    if (results.length > 0) return { type: 'search', query: m };
  }

  return { type: 'fallback' };
}


