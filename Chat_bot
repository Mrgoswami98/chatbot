      tags: ((p.tags || '') + ' ' + (p.product_type || '') + ' ' + p.title).toLowerCase(),
      category: detectCategory(p.title + ' ' + (p.tags || '') + ' ' + (p.product_type || ''))
    }));
  } catch (e) {}
}

async function tryFetchSheetProducts() {
  if (!CONFIG.googleSheetCsvUrl) return;
  try {
    const res = await fetch(CONFIG.googleSheetCsvUrl);
    if (!res.ok) return;
    const csv = await res.text();
    const rows = parseCSV(csv);
    if (rows.length < 2) return;
    const headers = rows[0].map(h => h.trim().toLowerCase());
    sheetProducts = rows.slice(1).filter(r => r.length >= 2).map(r => {
      const obj = {};
      headers.forEach((h, i) => obj[h] = (r[i] || '').trim());
      return {
        name: obj.name || obj.product || obj.title || '',
        price: obj.price ? (String(obj.price).startsWith('₹') ? obj.price : '₹' + obj.price) : '',
        comparePrice: '',
        image: obj.image || obj.image_url || obj.img || '',
        url: obj.url || obj.link || '#',
        tags: ((obj.category || '') + ' ' + (obj.name || '')).toLowerCase(),
        category: (obj.category || '').toLowerCase(),
        source: 'sheet'
      };
    }).filter(p => p.name);
  } catch (e) {}
}

function detectCategory(text) {
  const t = text.toLowerCase();
  if (/gaming|gamer|racing/.test(t)) return 'gaming';
  if (/recliner/.test(t)) return 'recliner';
  if (/stool|bar/.test(t)) return 'stool';
  if (/accent|dining|lounge|velvet/.test(t)) return 'accent';
  if (/shelf|book|storage|rack|cabinet/.test(t)) return 'shelf';
  if (/office|task|executive|computer|mesh/.test(t)) return 'office';
  return 'other';
}

function parseCSV(text) {
  const rows = []; let row = []; let cell = ''; let inQuotes = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (c === '"' && text[i+1] === '"') { cell += '"'; i++; }
    else if (c === '"') { inQuotes = !inQuotes; }
    else if (c === ',' && !inQuotes) { row.push(cell); cell = ''; }
    else if ((c === '\n' || c === '\r') && !inQuotes) {
      if (cell || row.length) { row.push(cell); rows.push(row); row = []; cell = ''; }
      if (c === '\r' && text[i+1] === '\n') i++;
    } else { cell += c; }
  }
  if (cell || row.length) { row.push(cell); rows.push(row); }
  return rows;
}

function getAllProducts() {
  const websiteProducts = liveProducts.length > 0
    ? liveProducts.map(p => ({ ...p, source: 'website' }))
    : BUILTIN_PRODUCTS.map(p => ({ ...p, source: 'website' }));
  return [...websiteProducts, ...sheetProducts.map(p => ({ ...p, source: 'sheet' }))];
}

function filterByCategory(products, category) {
  if (!category) return products;
  return products.filter(p => {
    const haystack = (p.name + ' ' + p.tags + ' ' + (p.category || '')).toLowerCase();
    return haystack.includes(category);
  });
}

function searchProducts(query) {
  const all = getAllProducts();
  const q = query.toLowerCase().trim();
  if (!q) return all;
  const words = q.split(/\s+/).filter(w => w.length > 2);
  if (!words.length) return [];
  return all.filter(p => {
    const haystack = (p.name + ' ' + p.tags).toLowerCase();
    return words.some(w => haystack.includes(w));
  });
}

function getCheapestProduct() {
  const all = getAllProducts();
  return all.reduce((min, p) => {
    const price = parseInt(String(p.price).replace(/[^\d]/g, '')) || Infinity;
    const minPrice = parseInt(String(min.price).replace(/[^\d]/g, '')) || Infinity;
    return price < minPrice ? p : min;
  }, all[0]);
}


