      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="9" y1="13" x2="15" y2="13"/>
        <line x1="9" y1="17" x2="15" y2="17"/>
      </svg>
    </div>
    <div class="oc-form-cta-text">
      <strong>${escapeHtml(cta.title)}</strong>
      <small>${escapeHtml(cta.subtitle)}</small>
    </div>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.9">
      <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
    </svg>
  `;
  messagesEl.appendChild(link);
  scrollToBottom();
}

function addFeedbackBubble(lang) {
  const text = R('feedback_request', lang);
  const wrap = document.createElement('div');
  wrap.className = 'oc-feedback';
  wrap.innerHTML = `
    <span style="font-size:12px;color:var(--oak-muted);align-self:center;margin-right:6px;">${escapeHtml(text)}</span>
    <button data-fb="up" title="Yes">👍</button>
    <button data-fb="down" title="No">👎</button>
  `;
  wrap.querySelectorAll('button').forEach(btn => {
    btn.addEventListener('click', () => {
      const fb = btn.dataset.fb;
      wrap.remove();
      if (fb === 'up') {
        addBotMessage(R('feedback_positive', lang));
      } else {
        addBotMessage(R('feedback_negative', lang));
        addWhatsAppCTA(lang);
      }
    });
  });
  messagesEl.appendChild(wrap);
  scrollToBottom();
}

function addUserMessage(text) {
  const msg = document.createElement('div');
  msg.className = 'oc-msg user';
  msg.textContent = text;
  messagesEl.appendChild(msg);
  scrollToBottom();
}

function showTyping() {
  const typing = document.createElement('div');
  typing.className = 'oc-typing';
  typing.id = 'oc-typing-indicator';
  typing.innerHTML = '<span></span><span></span><span></span>';
  messagesEl.appendChild(typing);
  scrollToBottom();
}
function hideTyping() {
  const t = document.getElementById('oc-typing-indicator');
  if (t) t.remove();
}

function scrollToBottom() {
  setTimeout(() => { messagesEl.scrollTop = messagesEl.scrollHeight; }, 50);
}

function escapeHtml(text) { const div = document.createElement('div'); div.textContent = String(text); return div.innerHTML; }
function escapeAttr(text) { return String(text).replace(/"/g, '&quot;'); }
function linkify(text) {
  return text.replace(/(oakcraft\.in[^\s<,]*)/g, '<a href="https://$1" target="_blank" rel="noopener">$1</a>')
             .replace(/(forms\.gle[^\s<,]*)/g, '<a href="https://$1" target="_blank" rel="noopener">$1</a>');
}


// ================================================================
// MAIN MESSAGE HANDLER
// ================================================================
async function sendUserMessage(text) {
  if (!text.trim()) return;
  addUserMessage(text);
  input.value = '';
  input.style.height = 'auto';

  const lang = getLang(text);
  currentLang = lang;
  const mood = detectMood(text);

  conversationHistory.push({ role: 'user', text, lang, mood });

  showTyping();
  await new Promise(r => setTimeout(r, 500 + Math.random() * 500));
  hideTyping();

  // Mood-based empathy first
  if (mood === 'frustrated' && !['damaged', 'complaint', 'cancel_order'].includes(lastIntent)) {
    addBotMessage(R('empathy_frustrated', lang));
    await new Promise(r => setTimeout(r, 600));
  }

  const intent = detectIntent(text, conversationHistory);
  lastIntent = intent.type;

  let showFeedback = false;

  switch (intent.type) {
    case 'greeting':
      addBotMessage(pick([
        R('welcome', lang).split('\n\n')[0],
        lang === 'hinglish' ? "Hey! 😊 Bolo bolo, kya help karu?" :
        lang === 'hi' ? "नमस्ते! 😊 बताइए क्या चाहिए?" :
        lang === 'mr' ? "नमस्कार! 😊" :
        lang === 'gu' ? "નમસ્તે! 😊" :
        lang === 'hr' ? "Ram Ram! 😊 Bata bhai." :
        "Hey! 😊 What can I help with?"
      ]));
      addQuickReplies(R('fallback_quick', lang));
      break;

    case 'how_are_you':
      addBotMessage(lang === 'hinglish' ? "Main mast hoon yaar! 😊 Tum batao, kya scene hai? Kuch chahiye ya bas chitchat?" :
                    lang === 'hi' ? "मैं बढ़िया हूँ! 😊 आप बताइए, क्या मदद चाहिए?" :
                    lang === 'mr' ? "मी छान आहे! 😊 तुम्हाला काय मदत हवी?" :
                    lang === 'gu' ? "હું મજામાં છું! 😊 તમારી શું મદદ?" :
                    lang === 'hr' ? "Mhanne theek bhai! 😊 Tu bata, kya chahiye?" :
                    "I'm doing great, thanks for asking! 😊 You? Anything I can help with?");
      break;

    case 'fun_mode':
      funMode = true;
      addBotMessage(R('fun_mode_intro', lang));
      addQuickReplies(lang === 'hinglish' ? ["Joke sunao", "Recommend something", "Just chat"] :
                      lang === 'hi' ? ["जोक सुनाओ", "कुछ recommend करो", "बस बातें करो"] :
                      ["Tell a joke", "Recommend something", "Just chat"]);
      break;

    case 'joke':
      addBotMessage(R('joke', lang));
      break;

    case 'compliment':
      addBotMessage(R('compliment_response', lang));
      break;

    case 'insult':
      addBotMessage(R('insult_handle', lang));
      break;

    case 'about':
      addBotMessage(R('about', lang));
      addQuickReplies(R('fallback_quick', lang));
      break;

    case 'show_products': {
      const intro = intent.category && RESPONSES.category_intro[intent.category]
        ? R(intent.category === 'office' ? 'category_intro' : 'category_intro', lang) || ''
        : R('showing_products', lang);
      const introText = intent.category && RESPONSES.category_intro[intent.category]
        ? (RESPONSES.category_intro[intent.category][lang] ? pick(RESPONSES.category_intro[intent.category][lang]) : pick(RESPONSES.category_intro[intent.category].en))
        : R('showing_products', lang);
      addBotMessage(introText);
      const products = filterByCategory(getAllProducts(), intent.category).slice(0, CONFIG.maxProducts);
      if (products.length) addProductCards(products);
      else {
        addBotMessage(R('no_products_found', lang));
        addProductCards(getAllProducts().slice(0, 4));
      }
      showFeedback = true;
      break;
    }

    case 'search': {
      const results = searchProducts(intent.query);
      if (results.length) {
        addBotMessage(R('showing_products', lang));
        addProductCards(results.slice(0, CONFIG.maxProducts));
        showFeedback = true;
      } else {
        addBotMessage(R('fallback', lang));
        addQuickReplies(R('fallback_quick', lang));
      }
      break;
    }

    case 'shipping': addBotMessage(R('shipping', lang)); break;
    case 'returns': addBotMessage(R('returns', lang)); break;
    case 'warranty':
      addBotMessage(R('warranty', lang));
      addFormCTA('warranty', lang);
      break;
    case 'price_general':
      addBotMessage(R('price_general', lang));
      addQuickReplies(R('fallback_quick', lang));
      break;
    case 'payment': addBotMessage(R('payment', lang)); break;
    case 'emi': addBotMessage(R('emi', lang)); break;
    case 'cod': addBotMessage(R('cod', lang)); break;
    case 'assembly': addBotMessage(R('assembly', lang)); break;
    case 'material': addBotMessage(R('material', lang)); break;
    case 'size_dimension': addBotMessage(R('size_dimension', lang)); break;
    case 'weight_capacity': addBotMessage(R('weight_capacity', lang)); break;

    case 'bulk_order':
      addBotMessage(R('bulk_order', lang));
      addWhatsAppCTA(lang, "Hi! I want to place a bulk order. Please share details.");
      break;

    case 'contact':
      addBotMessage(R('contact', lang));
      addWhatsAppCTA(lang);
      break;

    case 'order_track':
      addBotMessage(R('order_track', lang));
      addWhatsAppCTA(lang, "Hi! I want to track my order. Order ID: ");
      break;

    case 'cancel_order':
      addBotMessage(R('cancel_order', lang));
      addWhatsAppCTA(lang, "Hi, I want to cancel my order. Order ID: ");
      break;

    case 'damaged':
      addBotMessage(R('damaged', lang));
      addFormCTA('complaint', lang);
      addWhatsAppCTA(lang, "Hi, my order arrived damaged. Order ID: ");
      break;

    case 'complaint':
      addBotMessage(R('complaint', lang));
      addFormCTA('complaint', lang);
      addWhatsAppCTA(lang, "Hi, I have a complaint regarding my order. ");
      break;

    case 'installation':
      addBotMessage(R('installation', lang));
      addFormCTA('installation', lang);
      break;

    case 'recommendation':
      addBotMessage(R('recommendation', lang));
      addQuickReplies(lang === 'hinglish' ? ["Best office chair", "Cheap option", "Premium pick"] :
                      lang === 'hi' ? ["बेस्ट ऑफिस चेयर", "सस्ता ऑप्शन", "प्रीमियम"] :
                      ["Best office chair", "Cheap option", "Premium pick"]);
      break;

    case 'best_seller':
      addBotMessage(R('best_seller', lang));
      addProductCards(getAllProducts().slice(0, 4));
      break;

    case 'cheap_options':
      addBotMessage(R('cheap_options', lang));
      const cheap = [...getAllProducts()].sort((a, b) => {
        const ap = parseInt(String(a.price).replace(/[^\d]/g, '')) || 999999;
        const bp = parseInt(String(b.price).replace(/[^\d]/g, '')) || 999999;
        return ap - bp;
      });
      addProductCards(cheap.slice(0, 4));
      break;

    case 'premium_options':
      addBotMessage(R('premium_options', lang));
      const premium = [...getAllProducts()].sort((a, b) => {
        const ap = parseInt(String(a.price).replace(/[^\d]/g, '')) || 0;
        const bp = parseInt(String(b.price).replace(/[^\d]/g, '')) || 0;
        return bp - ap;
      });
      addProductCards(premium.slice(0, 4));
      break;

    case 'discount': addBotMessage(R('discount', lang) || "🎉 Use FIRST5 for 5% off your first order!"); break;
    case 'hours_open': addBotMessage(R('hours_open', lang)); break;
    case 'location': addBotMessage(R('location', lang)); break;
    case 'social_media': addBotMessage(R('social_media', lang)); break;
    case 'thanks': addBotMessage(R('thanks', lang)); break;
    case 'bye': addBotMessage(R('bye', lang)); break;
    case 'yes_response':
      addBotMessage(R('yes_response', lang));
      addQuickReplies(R('fallback_quick', lang));
      break;
    case 'no_response': addBotMessage(R('no_response', lang)); break;
    case 'weather_or_random': addBotMessage(R('weather_or_random', lang)); break;

    case 'fallback':
    default:
      addBotMessage(R('fallback', lang));
      addQuickReplies(R('fallback_quick', lang));
      break;
  }

  // Add feedback bubble after product showings (every 3rd time to not annoy)
  if (showFeedback && conversationHistory.length % 6 === 0) {
    setTimeout(() => addFeedbackBubble(lang), 800);
  }

  conversationHistory.push({ role: 'bot', intent: intent.type, lang });

  // discount fallback
  if (intent.type === 'discount' && !RESPONSES.discount) {
    // Already handled above
  }
}

// Add discount response
RESPONSES.discount = {
  en: ["🎉 Yes! Use code **FIRST5** at checkout for 5% off your first order. We also run seasonal sales — follow @oakcraftfurniture on Instagram!"],
  hi: ["🎉 हाँ! कोड FIRST5 से पहले ऑर्डर पर 5% छूट!"],
  hinglish: ["🎉 Haan! Code **FIRST5** se pehle order pe 5% off! Instagram pe @oakcraftfurniture follow karein seasonal sales ke liye!"],
  mr: ["🎉 कोड FIRST5 ने 5% सूट!"],
  gu: ["🎉 કોડ FIRST5 થી 5% છૂટ!"],
  hr: ["🎉 Code FIRST5 se 5% chhoot!"]
};

sendBtn.addEventListener('click', () => sendUserMessage(input.value));
input.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendUserMessage(input.value);
  }
});
input.addEventListener('input', () => {
  input.style.height = 'auto';
  input.style.height = Math.min(input.scrollHeight, 100) + 'px';
});


// ================================================================
// VOICE INPUT
// ================================================================
let recognition = null;
let isRecording = false;

function initVoiceInput() {
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SpeechRecognition) { micBtn.style.display = 'none'; return; }
  recognition = new SpeechRecognition();
  recognition.continuous = false;
  recognition.interimResults = true;
  recognition.maxAlternatives = 1;

  recognition.onstart = () => {
    isRecording = true;
    micBtn.classList.add('recording');
    input.placeholder = { en: 'Listening...', hi: 'सुन रहा हूँ...', hinglish: 'Sun raha hoon...', mr: 'ऐकत आहे...', gu: 'સાંભળી રહ્યો છું...', hr: 'Sun raha hoon...' }[currentLang] || 'Listening...';
  };
  recognition.onend = () => {
    isRecording = false;
    micBtn.classList.remove('recording');
    input.placeholder = { en: 'Type your question...', hi: 'अपना सवाल लिखें...', hinglish: 'Apna sawal likhein...', mr: 'तुमचा प्रश्न लिहा...', gu: 'તમારો પ્રશ્ન લખો...', hr: 'Apna sawal likh de...' }[currentLang] || 'Type your question...';
  };
  recognition.onresult = (event) => {
    let transcript = '';
    for (let i = 0; i < event.results.length; i++) transcript += event.results[i][0].transcript;
    input.value = transcript;
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 100) + 'px';
    if (event.results[event.results.length - 1].isFinal) {
      setTimeout(() => sendUserMessage(transcript), 300);
    }
  };
  recognition.onerror = () => { isRecording = false; micBtn.classList.remove('recording'); };
}
initVoiceInput();

micBtn.addEventListener('click', () => {
  if (!recognition) return;
  if (isRecording) { recognition.stop(); return; }
  const langMap = { en: 'en-IN', hi: 'hi-IN', hinglish: 'en-IN', mr: 'mr-IN', gu: 'gu-IN', hr: 'hi-IN' };
  recognition.lang = langMap[currentLang] || 'en-IN';
  try { recognition.start(); } catch(e) {}
});

tryFetchLiveProducts();
tryFetchSheetProducts();
</script>

